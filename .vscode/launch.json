{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PM3 Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "pm3_dashboard",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Pytest (todos los tests)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
